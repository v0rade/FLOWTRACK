# =============================================================================
# FLOWTRACK — Environment Configuration Example
# Copy this file to .env.local when connecting to an external Supabase project.
#
# NOTE:
# - Never commit real secret keys to version control.
# - If NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are omitted
#   or left as placeholders, FLOWTRACK automatically boots an embedded
#   in-memory PostgreSQL engine (PGlite) on the server, applies all SQL
#   migrations + Row Level Security policies in supabase/migrations/*.sql, and
#   loads the fictional Nusantara Supplies Co. demo dataset (supabase/seed.sql).
# =============================================================================

# Public Supabase project URL and anonymous key (safe for browser/SSR client;
# all table access is governed by PostgreSQL Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Service Role key — used ONLY by the CLI seed script (npm run db:seed)
# to provision initial demo auth accounts. Never imported by the web application.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional password used when npm run db:seed creates demo users in Supabase Auth
DEMO_USER_PASSWORD=FlowtrackDemo#2026

# Optional: set to "true" to force the embedded PostgreSQL demo engine even when
# external Supabase credentials are present in .env.local
FLOWTRACK_USE_EMBEDDED_DB=false
